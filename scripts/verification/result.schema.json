{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object",
  "required":["schemaVersion"],
  "properties":{"schemaVersion":{"type":"integer","enum":[1,3]}},
  "if":{"required":["schemaVersion"],"properties":{"schemaVersion":{"const":1}}},
  "then":{
    "type":"object","additionalProperties":false,
    "required":["schemaVersion","runId","status","summary","sourceState","agentVerdict","checks","findings","artifacts","unverified","execution","runRoot"],
    "properties":{
      "schemaVersion":{"const":1},"runId":{"type":["string","null"]},"runRoot":{"type":["string","null"]},
      "status":{"enum":["completed","incomplete","blocked","source_changed","timed_out"]},"summary":{"type":"string"},
      "sourceState":{"enum":["unchanged","changed","unreadable"]},"agentVerdict":{"enum":["pass","fail","incomplete",null]},
      "checks":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["command","exitCode","evidencePath","eventId"],"properties":{"command":{"type":"string"},"exitCode":{"type":"integer"},"evidencePath":{"type":"string"},"eventId":{"type":"string"}}}},
      "findings":{"type":"array","items":{"type":"string"}},"unverified":{"type":"array","items":{"type":"string"}},
      "artifacts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","size","sha256"],"properties":{"path":{"type":"string"},"size":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"}}}},
      "execution":{"type":"object","additionalProperties":false,"required":["runId","started","exitCode","timedOut","processTreeStopped","eventsPath","stderrPath","agentResultPath","effectiveConfigPath"],"properties":{"runId":{"type":"string"},"started":{"type":"boolean"},"exitCode":{"type":["integer","null"]},"timedOut":{"type":"boolean"},"processTreeStopped":{"type":"boolean"},"eventsPath":{"type":"string"},"stderrPath":{"type":"string"},"agentResultPath":{"type":"string"},"effectiveConfigPath":{"type":"string"}}}
    }
  },
  "else":{
    "type":"object","additionalProperties":false,
    "required":["schemaVersion","runId","status","summary","sourceState","baselineState","proposalVerdict","replayVerdict","checks","findings","artifacts","unverified","execution","previousRunId","runRoot","sourceManifestPath","scope","limitations"],
    "properties":{
      "schemaVersion":{"type":"integer","const":3},
      "runId":{"type":["string","null"]},
      "status":{"enum":["completed","incomplete","blocked","source_changed","timed_out"]},
      "summary":{"type":"string"},
      "sourceState":{"enum":["unchanged","changed","unreadable"]},
      "baselineState":{"enum":["unchanged","changed","unreadable"]},
      "proposalVerdict":{"enum":["reference-only",null]},
      "replayVerdict":{"enum":["candidate-supported","not-reproduced","still-failing","reproduced","current-pass","current-fail","undetermined"]},
      "checks":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["role","commandId","sandboxId","recordPath","recordHash","exitCode"],"properties":{
        "role":{"enum":["replay-before","replay-after"]},"commandId":{"type":"string","pattern":"^replay-(before|after)-[0-9a-f]{12}$"},"sandboxId":{"type":"string","minLength":1},
        "recordPath":{"type":"string","minLength":1},"recordHash":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},"exitCode":{"type":["integer","null"]}}}},
      "findings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["description","sourcePaths"],"properties":{"description":{"type":"string"},"sourcePaths":{"type":"array","items":{"type":"string"}}}}},
      "artifacts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["kind","path","size","sha256","previousRunId"],"properties":{
        "kind":{"enum":["test","replacement"]},"path":{"type":"string","minLength":1},"size":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},"previousRunId":{"type":["string","null"]}}}},
      "unverified":{"type":"array","items":{"type":"string"}},
      "execution":{"type":"object","additionalProperties":false,
        "required":["proposalCreated","replayCreatedCount","proposalStopped","replayAllStopped","failureStage","exitCodeForCli","pilotInputId","pilotInputPath","pilotInputHash"],
        "properties":{
          "proposalCreated":{"type":"boolean"},"replayCreatedCount":{"type":"integer","minimum":0},
          "proposalStopped":{"type":["boolean","null"]},"replayAllStopped":{"type":["boolean","null"]},
          "failureStage":{"type":["string","null"]},"exitCodeForCli":{"type":"integer","enum":[0,1,2]},
          "pilotInputId":{"type":["string","null"]},"pilotInputPath":{"type":["string","null"]},"pilotInputHash":{"type":["string","null"],"pattern":"^[A-Fa-f0-9]{64}$"}}},
      "previousRunId":{"type":["string","null"]},
      "runRoot":{"type":["string","null"]},
      "sourceManifestPath":{"type":["string","null"]},
      "scope":{"enum":["synthetic-pilot",null]},
      "limitations":{"type":"array","uniqueItems":true,"items":{"enum":["clipboard-text-write-possible","pid-count-unbounded","daemon-disconnect-unverified"]}}
    },
    "allOf":[
      {"if":{"properties":{"status":{"const":"completed"}}},
       "then":{"properties":{"replayVerdict":{"not":{"const":"undetermined"}},"execution":{"properties":{"exitCodeForCli":{"enum":[0,1]}}}}},
       "else":{"properties":{"replayVerdict":{"const":"undetermined"},"execution":{"properties":{"exitCodeForCli":{"const":2}}}}}},
      {"if":{"properties":{"scope":{"const":null}}},
       "then":{"properties":{"limitations":{"maxItems":0}}},
       "else":{"properties":{"limitations":{"minItems":3}}}}
    ]
  }
}
